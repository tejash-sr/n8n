# ============================================================================
# Lead Inbox Triage Bot — Local n8n environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# These variables are consumed by docker-compose.yml and by n8n at runtime.
# ============================================================================

# ---- n8n core ----
# Basic auth for the n8n UI on http://localhost:5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_in_local_only

# Public URL n8n uses to build webhook URLs (use http://localhost:5678 for local)
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Timezone (matches Grootan / IST training environment)
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Encryption key for stored credentials — generate with: openssl rand -hex 32
# This MUST be stable across restarts or saved credentials become unreadable.
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# ---- LLM provider ----
# Used by the OpenAI / Anthropic credentials inside n8n.
# Stored as n8n credentials in the UI — these env vars are only a convenience.
OPENAI_API_KEY=sk-replace-me
# ANTHROPIC_API_KEY=sk-ant-replace-me

# ---- Google (Gmail + Sheets OAuth2) ----
# Created in Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Authorized redirect URI must be: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me

# Google Sheet that backs the CRM (created from sheets/CRM_SHEET_TEMPLATE.md)
CRM_SPREADSHEET_ID=replace_with_google_sheet_id

# ---- Slack (optional but recommended) ----
# Slack app -> OAuth & Permissions. Bot token starts with xoxb-
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_LEADS_CHANNEL=#training-leads
SLACK_ERRORS_CHANNEL=#training-leads-errors
