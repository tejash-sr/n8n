{
  "name": "LeadInboxTriageBot_ErrorHandler_GT",
  "nodes": [
    {
      "parameters": {
        "content": "# Error Handler · Sub-workflow\n## Lead Inbox Triage Bot — Grootan Internal Training (batch `batch-may-2026`)\n\n**Trainee:** `<initials = GT>`\n\n**This workflow runs:** whenever the main workflow fails. Wired via `settings.errorWorkflow` in `LeadInboxTriageBot_GT`. Builds an `errors`-tab row from the failed execution and pings Slack.\n\n_See `docs/PHASES.md` for the acceptance criteria for this phase._",
        "height": 160,
        "width": 1180,
        "color": 7
      },
      "id": "b84443c2-edfd-4a36-9f6f-cd29b53f95bb",
      "name": "Section_PhaseBanner",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        40
      ]
    },
    {
      "parameters": {
        "content": "# 🔴 Error Handler\nError Trigger → Build error row → Append errors tab + Slack alert (parallel).\nBoth writers have `retryOnFail=true, maxTries=3, waitBetweenTries=5000`. Never re-triggers the main workflow.",
        "height": 140,
        "width": 520,
        "color": 3
      },
      "id": "996bd358-bba1-4a99-ab92-c7791aacab43",
      "name": "Section_Error",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d77e1ec7-c37a-4d2d-b0be-3ee5ca83b84e",
              "name": "spreadsheetId",
              "type": "string",
              "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID"
            },
            {
              "id": "91ad84c5-9504-4842-8d21-f177a25bd1c0",
              "name": "slackChannel",
              "type": "string",
              "value": "#training-leads"
            },
            {
              "id": "8395e36d-5606-46fe-acf9-bef5fa892005",
              "name": "slackErrorChannel",
              "type": "string",
              "value": "#training-leads-errors"
            },
            {
              "id": "9c6e0c66-fe99-4b6a-8ccf-d09910277aea",
              "name": "model",
              "type": "string",
              "value": "gpt-4o-mini"
            },
            {
              "id": "fa62d9ee-3cdd-4adc-8a36-9e798f6858a1",
              "name": "temperature",
              "type": "number",
              "value": 0.1
            },
            {
              "id": "9e00abbf-cbc0-45e0-a58e-9eaeca8623a0",
              "name": "signature",
              "type": "string",
              "value": "— Grootan Team\n+91-44-XXXX-XXXX | grootan.com"
            },
            {
              "id": "6f51b59a-8a72-4e91-a4f8-b26643149120",
              "name": "batch",
              "type": "string",
              "value": "batch-may-2026"
            }
          ]
        },
        "options": {}
      },
      "id": "ffc91924-64be-4e78-9c05-7aa9bc63ec6c",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        400,
        460
      ],
      "notes": "Tenant-style settings. Point spreadsheetId / Slack channels / model / signature here. Prompts live in the separate 'Prompts' Set node.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "6e4efb36-3023-4efe-9735-59be48212052",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        400,
        280
      ],
      "notes": "Receives the failed-execution payload from the main workflow.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ac34991d-c371-4125-bd08-c20afb229f3c",
              "name": "message_id",
              "type": "string",
              "value": "={{ $json.execution?.error?.context?.message_id || $json.execution?.lastNodeExecuted || '' }}"
            },
            {
              "id": "900a9788-160d-47f2-85ed-3ed452290965",
              "name": "received_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "d8848260-149f-4a0a-bc42-3ca47566c9e3",
              "name": "error_stage",
              "type": "string",
              "value": "={{ $json.execution?.lastNodeExecuted || 'unknown' }}"
            },
            {
              "id": "a6531228-59f8-44de-b280-e2837406cd23",
              "name": "error_message",
              "type": "string",
              "value": "={{ ($json.execution?.error?.message || $json.error?.message || 'unknown error').toString().slice(0,500) }}"
            },
            {
              "id": "92efbf55-70e6-46e5-a349-dbd0321ca58d",
              "name": "raw_payload",
              "type": "string",
              "value": "={{ JSON.stringify($json).slice(0, 1000) }}"
            },
            {
              "id": "911a5fb3-4b44-4dd4-b750-c4eec65d1873",
              "name": "created_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a07bd5d3-3001-4950-a3b1-180c767005f1",
      "name": "Build error row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        700,
        280
      ],
      "notes": "Normalises the error payload to the 'errors' tab schema. error_message truncated to 500 chars (was 280).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "expression",
          "value": "={{ $node[\"Config\"].json.spreadsheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "errors",
          "cachedResultName": "errors"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "message_id": "={{ $json.message_id }}",
            "received_at": "={{ $json.received_at }}",
            "error_stage": "={{ $json.error_stage }}",
            "error_message": "={{ $json.error_message }}",
            "raw_payload": "={{ $json.raw_payload }}",
            "created_at": "={{ $json.created_at }}"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "c2dee11c-3386-468f-b4b6-d4c3cc9354a7",
      "name": "Append errors row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        1000,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER_SHEETS_OAUTH",
          "name": "Sheets - Triage Training"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Append to 'errors' tab with explicit column mapping.",
      "notesInFlow": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "expression",
          "value": "={{ $node[\"Config\"].json.slackErrorChannel }}"
        },
        "text": "=:rotating_light: *Lead Triage Bot error*\n*Stage:* `{{ $json.error_stage }}`\n*Message:* {{ $json.error_message }}\n*Time:* {{ $json.created_at }}\n*Payload:* ```{{ $json.raw_payload }}```",
        "otherOptions": {}
      },
      "id": "2d00be9f-bcef-40f7-b307-adef740c91dd",
      "name": "Post error alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1000,
        380
      ],
      "credentials": {
        "slackApi": {
          "id": "PLACEHOLDER_SLACK_API",
          "name": "Slack - Triage Bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "continueOnFail": true,
      "notes": "Brief alert. Retries enabled (3x, 5s). continueOnFail=true.",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build error row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build error row": {
      "main": [
        [
          {
            "node": "Append errors row",
            "type": "main",
            "index": 0
          },
          {
            "node": "Post error alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "tags": [
    {
      "name": "training"
    },
    {
      "name": "lead-triage"
    },
    {
      "name": "error-handler"
    },
    {
      "name": "batch-may-2026"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "Error handler for the Lead Inbox Triage Bot. Appends a row to the 'errors' tab and posts an alert to #training-leads-errors. Never re-triggers the failing workflow.\n\nRetries: enabled on Sheets + Slack appends (3x, 5s backoff) so a transient Sheets outage doesn't drop the error."
  }
}